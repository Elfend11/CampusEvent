# ------------------------------------------------------------------
# CampusEvent - repository ignore rules
# ------------------------------------------------------------------

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Backend - Laravel
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot/
/backend/public/storage
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
!/backend/storage/framework/cache/data/.gitignore
!/backend/storage/framework/sessions/.gitignore
!/backend/storage/framework/testing/.gitignore
!/backend/storage/framework/views/.gitignore
!/backend/storage/logs/.gitignore
/backend/bootstrap/cache/*.php
/backend/.phpunit.result.cache
/backend/.phpunit.cache/

# Frontend - Vue.js 3 + Vite
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/coverage/
/frontend/*.local

# PHP tooling
.php-cs-fixer.cache
.php-cs-fixer.php
/backend/_ide_helper.php
/backend/_ide_helper_models.php

# Test and coverage output
coverage/
*.lcov
junit.xml

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
tmp/
temp/

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sublime-workspace

# Build artifacts
*.zip
